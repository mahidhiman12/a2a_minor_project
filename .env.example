# Copy this file to .env and edit.  Nothing here costs money.

# Which "brain" the Citizen Concierge uses to understand complaints:
#   rules  -> keyword/regex engine, no key needed, works offline (default)
#   ollama -> free local LLM (install from https://ollama.com, then: ollama pull llama3.2)
#   gemini -> Google Gemini free tier (key from https://aistudio.google.com/apikey)
NLU_MODE=rules

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# For the ADK host agent (needs tool calling) prefer: qwen2.5:7b  or  llama3.1:8b

# --- Gemini free tier ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simulated department processing delay (seconds)
DEPT_DELAY=0.6

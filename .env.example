# Copy this file to .env and edit.  Nothing here costs money.

# Which "brain" the Citizen Concierge uses to understand complaints:
#   rules  -> keyword/regex engine, no key needed, works offline (default)
#   ollama -> free local LLM (install from https://ollama.com, then: ollama pull llama3.2)
#   gemini -> Google Gemini free tier (key from https://aistudio.google.com/apikey)
NLU_MODE=rules

# --- Ollama (local) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# For the ADK host agent (needs tool calling) prefer: qwen2.5:7b  or  llama3.1:8b

# --- Gemini free tier ---
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Simulated department processing delay (seconds)
DEPT_DELAY=0.6

# Days a resolved ticket waits for the citizen to confirm or reopen before it closes itself
AUTO_CLOSE_DAYS=3

#  put a contact email , Nominatim's usage rules ask.
NOMINATIM_EMAIL=

# --- Login & roles (demo-grade auth) ---
# Signs the session cookie. Generate your own: python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
SESSION_HOURS=8
# Shared token the Concierge sends to the department agents' /tickets endpoints (header X-Service-Token)
SERVICE_TOKEN=change-me-service-token
# Demo account passwords (accounts are created on first start if they don't exist)
DEMO_CITIZEN_PASSWORD=citizen123
DEMO_OFFICER_PASSWORD=officer123
DEMO_ADMIN_PASSWORD=admin123
# Optional per-account override, e.g.
# DEMO_PASSWORD_WATER_OFFICER=water123
